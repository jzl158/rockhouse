# Copy to .env.local for local development. In Vercel, add these under
# Project Settings -> Environment Variables. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site, no trailing slash (used in email links)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Resend (transactional email) - not wired up yet
RESEND_API_KEY=
