# Copy to .env.local and fill in. Never commit .env.local.
# Values come from the client's Supabase project (Project Settings -> API,
# and Connect -> Session pooler for DATABASE_URL).

# --- Used by the app (also go into Vercel) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the deployed site, no trailing slash (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend (transactional email) - not wired up yet
RESEND_API_KEY=

# --- Used only by `npm run setup:db` (never go into Vercel) --------------------
# Session pooler string: Supabase dashboard -> Connect -> Session pooler.
# Must be port 5432, not 6543.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# First admin login to create. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
